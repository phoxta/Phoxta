{
  "name": "femi-portfolio-apps",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3020",
    "build": "npm run gen && node scripts/copy-ort.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --port 3020",
    "typecheck": "tsc --noEmit",
    "shots": "node scripts/shots.mjs",
    "product-index": "node scripts/build-product-index.mjs",
    "app-shots": "node scripts/app-shots.mjs",
    "tokens": "node scripts/build-tokens.mjs",
    "icons": "node scripts/build-icon-shim.mjs",
    "gen": "node scripts/build-tokens.mjs && node scripts/build-icon-shim.mjs && node scripts/build-product-index.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@huggingface/transformers": "^4.2.0",
    "@primer/octicons-react": "^19.33.0",
    "@primer/primitives": "^11.10.0",
    "@primer/react": "^38.38.0",
    "@supabase/supabase-js": "^2.116.0",
    "@untitledui/icons": "^0.0.22",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.30.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@carbon/colors": "^11.57.0",
    "@carbon/layout": "^11.58.0",
    "@carbon/motion": "^11.51.0",
    "@carbon/type": "^11.66.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
