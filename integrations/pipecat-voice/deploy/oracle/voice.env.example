# Copy to `voice.env` on the VM and fill in. These are exactly the variables the
# Railway service already had — `railway variables` prints the live values.
# NEVER commit the filled-in copy; only this example belongs in git.

# --- Speech ---
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# --- Phoxta agent brain (Supabase edge function) ---
PHOXTA_AGENT_URL=https://ktgleoqvdikngocygdkn.supabase.co/functions/v1/agent-inbound
PHOXTA_AGENT_KEY=
SUPABASE_ANON_KEY=

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Server ---
PORT=8765
# Must match VOICE_DOMAIN in .env — server.py builds the wss:// URL it hands
# Twilio from this, so a stale value sends the stream to the wrong host.
PUBLIC_HOST=voice.phoxta.com
RECORD_CALLS=0

# --- Optional ---
# Origins allowed to use the in-browser widget (SmallWebRTC /offer path).
# ALLOWED_ORIGINS=https://phoxta.com,https://www.phoxta.com
# Natural end-of-turn detection. Local ONNX, no API key, but it costs real CPU
# per frame on top of Silero VAD — fine on 4 Ampere cores, not on a small box.
# SMART_TURN=1
