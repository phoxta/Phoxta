# Copy to `voice.env` on the VM and fill in. These are exactly the variables the
# Railway service already had — `railway variables` prints the live values.
# NEVER commit the filled-in copy; only this example belongs in git.

# --- Speech ---
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# --- Phoxta agent brain (Supabase edge function) ---
PHOXTA_AGENT_URL=https://ktgleoqvdikngocygdkn.supabase.co/functions/v1/agent-inbound
# Per-number → business mapping. `?key=<agent public key>` on the Twilio webhook
# URL wins; otherwise map each number here, DIGITS ONLY (env names can't hold the
# E.164 '+'), e.g. a call to +1 555 123 4567 → PHOXTA_KEY_15551234567=<key>.
# An unmapped number is turned away ("this number isn't set up yet"), NOT routed
# to a default business.
# PHOXTA_KEY_15551234567=the-agent-public-key
# Optional fallback key for the browser widget's /offer and /ws when they carry
# no ?key= (the widget always passes one, so this is rarely needed). It is NO
# LONGER a fallback for inbound phone routing — that must be mapped explicitly.
# PHOXTA_AGENT_KEY=
SUPABASE_ANON_KEY=

# The shared secret that proves calls/streams are real (see server.py + bot.py).
# MUST be identical to the Supabase secret VOICE_BRIDGE_SECRET, or the two sides
# disagree: with it set here but not there, agent-inbound ignores the proof; set
# there but not here, outbound streams are rejected. Generate: openssl rand -hex 32
# Unset = the doors run OPEN (today's behaviour) and a loud log line says so.
VOICE_BRIDGE_SECRET=

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Server ---
PORT=8765
# Must match VOICE_DOMAIN in .env — server.py builds the wss:// URL it hands
# Twilio from this, so a stale value sends the stream to the wrong host.
PUBLIC_HOST=voice.phoxta.com
RECORD_CALLS=0

# --- Self-hosted TURN (coturn) ---
# Must match static-auth-secret in turnserver.conf, and TURN_HOST is the public
# name/IP browsers relay through. Unset = STUN-only + Twilio TURN fallback.
# TURN_SECRET=
# TURN_HOST=voice.phoxta.com

# --- Optional ---
# Origins allowed to use the in-browser widget (SmallWebRTC /offer path). Unset
# defaults to phoxta.com, www.phoxta.com, phoxta.vercel.app and any *.phoxta.com
# storefront subdomain. Set a CSV to pin an exact list, or "*" for a dev box.
# ALLOWED_ORIGINS=https://phoxta.com,https://www.phoxta.com
# Concurrency ceilings on this box (a handful of Ampere cores carry live audio).
# MAX_SESSIONS=8            # global simultaneous sessions before /ws /offer 503
# MAX_SESSIONS_PER_KEY=3    # per-business ceiling
# Hard maximum call length in seconds (a wedged call can't hold a slot forever).
# MAX_CALL_SECS=3600
# Seconds uvicorn waits on SIGTERM for live calls to finish (keep <= the compose
# stop_grace_period and Caddy stream_close_delay, both 5m).
# SHUTDOWN_GRACE_SECS=300
# Natural end-of-turn detection. Local ONNX, no API key, but it costs real CPU
# per frame on top of Silero VAD — fine on 4 Ampere cores, not on a small box.
# SMART_TURN=1
