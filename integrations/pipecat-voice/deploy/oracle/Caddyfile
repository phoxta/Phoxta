{
	email {$ACME_EMAIL}
}

{$VOICE_DOMAIN} {
	# Caddy v2 proxies WebSocket upgrades transparently — no special directive
	# is needed for Twilio's /ws Media Stream. What matters is that the upgrade
	# answers 101; anything else surfaces as Twilio error 31920 mid-call.
	reverse_proxy voice:8765 {
		# A redeploy reloads config, which would otherwise hang up on everyone
		# mid-sentence. Let calls in progress finish instead.
		stream_close_delay 5m

		# A call holds one connection open for its whole duration, so the proxy
		# must not time out a stream that is simply quiet while the caller talks.
		# Both default to 0 already; stated explicitly so a future edit doesn't
		# quietly introduce a timeout that truncates calls.
		transport http {
			read_timeout 0
			write_timeout 0
		}
	}

	log {
		output file /data/access.log {
			roll_size 10mb
			roll_keep 3
		}
	}
}

{$STATUS_DOMAIN} {
	# Uptime Kuma. Its own login guards the dashboard; status pages it publishes
	# are public by design. WebSocket upgrade is how its live UI updates, which
	# reverse_proxy handles natively.
	reverse_proxy uptime:3001 {
		stream_close_delay 5m
	}
}

{$LLM_DOMAIN} {
	# The free tier: Supabase edge functions reach the two llama.cpp servers
	# here. One hostname and one certificate for both, because they are one API
	# to the caller — LOCAL_BASE_URL and LOCAL_EMBED_BASE_URL are the same
	# https://…/v1 and the split happens on the path, not in the config the
	# platform has to keep in step.
	#
	# Both upstreams enforce --api-key. This is an open text-generation
	# endpoint on the public internet; unauthenticated, it becomes somebody
	# else's free inference inside a day and the box's egress allowance with it.
	handle /v1/embeddings* {
		reverse_proxy embed:8080
	}

	handle {
		reverse_proxy llm:8080 {
			# No response timeout. A 4-core CPU takes 30-90s over a summary,
			# which is fine for a cron worker and would be a 504 here under
			# any of the usual defaults.
			transport http {
				read_timeout 0
				write_timeout 0
			}
		}
	}

	log {
		output file /data/llm-access.log {
			roll_size 10mb
			roll_keep 3
		}
	}
}
