{
    "name": "coir-six",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src",
        "typecheck:core": "tsc --noEmit -p packages/core",
        "mobile": "npm --workspace apps/mobile run start"
    },
    "dependencies": {
        "@coir-six/core": "*",
        "@supabase/supabase-js": "^2.108.2",
        "livekit-client": "^2.22.3",
        "lucide-react": "^0.546.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-router-dom": "^6.30.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.27.0",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^22.10.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitejs/plugin-react": "^4.3.4",
        "eslint": "^9.27.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react-hooks": "^5.2.0",
        "globals": "^16.0.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.7.0",
        "typescript-eslint": "^8.19.0",
        "vite": "^6.0.0"
    },
    "workspaces": [
        "packages/*",
        "apps/*"
    ]
}
